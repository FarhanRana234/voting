# Firebase web (public) config — safe to commit, these are public identifiers.
# Fill in the API key from Firebase Console → Project settings → General.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=voting-4e261.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=voting-4e261
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=voting-4e261.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=829554248701
NEXT_PUBLIC_FIREBASE_APP_ID=1:829554248701:web:fdc6d2768065f144dc6794

# Firebase Admin SDK (server-side) — generate a service account JSON:
# Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Admin panel password — pick your own.
ADMIN_PASSWORD=

# Random string used to sign the admin session cookie (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=